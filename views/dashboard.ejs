<%- include('partials/header') %>
<h1>My dashboard</h1>
<p class="muted">Your saved items.</p>

<% if (items.length === 0) { %>
  <div class="card"><p>You have no items yet.</p></div>
<% } else { %>
  <div class="list">
    <% items.forEach(function(item) { %>
      <a class="card row" href="/items/<%= item.id %>">
        <span class="row-title"><%= item.title %></span>
        <span class="muted small"><%= item.created_at %></span>
      </a>
    <% }); %>
  </div>
<% } %>
<%- include('partials/footer') %>
