<%- include('partials/header') %>
<h1>Min profil</h1>
<% if (saved) { %><p class="ok">Profil sparad.</p><% } %>

<div class="card">
  <p><strong>Användarnamn:</strong> <%= user.username %></p>
  <p><strong>Roll:</strong> <%= user.role %></p>
  <p><strong>Medlem sedan:</strong> <%= user.created_at %></p>
</div>

<form method="post" action="/profile" class="card">
  <label>Bio (visas på din profil)
    <textarea name="bio" rows="4"><%= user.bio %></textarea>
  </label>
  <button type="submit">Spara</button>
</form>

<h2>Förhandsvisning</h2>
<div class="card">
  <!-- Escapat -> säker version. Sårbara versionen renderar med <%- %> -->
  <p><%= user.bio %></p>
</div>
<%- include('partials/footer') %>
