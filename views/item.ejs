<%- include('partials/header') %>
<a class="muted small" href="/dashboard">&larr; Back</a>
<div class="card">
  <h1><%= item.title %></h1>
  <p><%= item.body %></p>
  <p class="muted small">Item #<%= item.id %> · owner-id <%= item.owner_id %></p>
</div>

<h2>Comments</h2>
<div class="list">
  <% if (comments.length === 0) { %>
    <p class="muted">No comments yet.</p>
  <% } %>
  <% comments.forEach(function(c) { %>
    <div class="card comment">
      <!-- <%= %> escapes the content -> no XSS in the secure version -->
      <p><%= c.content %></p>
      <p class="muted small"><%= c.username %> · <%= c.created_at %></p>
    </div>
  <% }); %>
</div>

<form method="post" action="/items/<%= item.id %>/comments" class="card">
  <label>Write a comment
    <textarea name="content" rows="2" required></textarea>
  </label>
  <button type="submit">Comment</button>
</form>
<%- include('partials/footer') %>
